# Root ignores for the revived repository. The legacy tree under pastsolvcon/
# keeps its own pastsolvcon/.gitignore; this file targets the incoming modmesh
# code (C++/pybind11 built via CMake) plus common Python and dev artifacts.

# Agent local notes (the shared .claude/ framework is tracked; local files are not)
CLAUDE.local.md

# OS cruft
.DS_Store

# Editors and IDEs
.idea
.vscode
.vs
.ipynb_checkpoints/

# ctags index
tags

# Python bytecode and packaging metadata
__pycache__/
*.pyc
*.pyo
*.egg-info/
MANIFEST

# Build and install output
build/
build.dbg/
dist/
setup.mk
setup.cfg

# Vendored third-party dependencies (downloaded or built locally)
thirdparty/install/
thirdparty/archive/
dep/
opt/

# Profiling results
profiling/results/

# Coverage data
.coverage

# Compiled C/C++ objects and shared libraries
*.o
*.os
*.?os
*.a
*.so
*.dylib
*.pyd
*.dll
*.def

# MSVC / Windows build artifacts
*.vcx*
*.sln
*.tlog
*.obj
*.pdb

# Local environment files
*.env

# Scratch space
tmp/
